# Node / Playwright (recon tooling only)
node_modules/
package.json
package-lock.json

# Raw reconnaissance dumps: NOT committed.
# These contain the unredacted `User` objects the Rowan API over-exposes
# (Username, External_Id / 9-digit Banner ID, Last_Login, Password key) plus
# multi-MB inline base64 images. Sanitized fixtures live in
# artifacts/reconnaissance/fixtures/ and ARE committed.
artifacts/reconnaissance/html/
artifacts/reconnaissance/network/
artifacts/reconnaissance/screenshots/
*.har

# Local CA bundle (derived; regenerate per endpoint-summary.md)
*-ca-bundle.pem
incommon.crt
incommon.pem

# Never commit
.env
*.secret

# Python bytecode
__pycache__/
*.pyc

# Production collection output lives in XDG state, outside the repo. This is a
# guard in case XDG_STATE_HOME is ever pointed inside the working tree.
collections/
*.collection.json

# uv / build
.venv/
dist/
*.egg-info/
.pytest_cache/

# Browser QA output. The *fixtures* under artifacts/qa/fixtures/ ARE committed --
# they are the regression cases. The generated page and its screenshots are not:
# they are reproducible from the fixtures in one command, they are large, and a
# screenshot of a real digest shows announcement content and published contact
# details that the fixtures themselves deliberately omit.
artifacts/qa/pages/
artifacts/qa/screenshots/
