          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Camden Shuttle Stop</name>
        <description>This is the location of the Shuttle stop for Camden Campus where students will either be dropped of or picked up for easy travel to this additional campus.&lt;br&gt;&lt;br&gt;Keywords: &lt;br&gt;Categories: Shuttle Stop Locations&lt;br&gt;Location: 39.9461061, -75.1186491</description>
